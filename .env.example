# Aplicación de Mercado Libre (no reutilizar las credenciales de Mercado Pago)
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=
# Debe ser la URL pública HTTPS de la tienda en producción.
NEXT_PUBLIC_BASE_URL=https://tu-dominio.com

# Cifrado de tokens OAuth de Mercado Pago: 32 bytes (64 caracteres hexadecimales).
# Mantener estable entre despliegues. No reemplazar sin migrar los tokens cifrados.
# Sin clave se rechazan nuevas escrituras; las conexiones heredadas siguen legibles.
# Al consultar la configuración activa con una clave válida se cifran sus tokens heredados.
ENCRYPTION_KEY=

# Google Gemini image generation (server-side only)
GEMINI_API_KEY=
POLLINATIONS_API_KEY=
POLLINATIONS_PROJECT=damaged-hippopotamus
